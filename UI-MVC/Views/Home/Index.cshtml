@{
    ViewData["Title"] = "Home";
}

<main>
    <section>
        <header>
            <h1>FilmManagement</h1>
            <p>
                A web application for managing films, directors, and actors.
            </p>
        </header>
    </section>

    <section>
        <h2>What is FilmManagement?</h2>
        <p>
            FilmManagement is an ASP.NET Core MVC application that allows you to create,
            edit, view, and delete films while managing their directors and actors.
        </p>
        <p>
            This application was developed as part of a learning project to practice
            layered architecture, domain-driven design, and web development with C#.
        </p>
    </section>

    <section>
        <h2>Main features</h2>
        <ul>
            <li>Create and manage films with genre, release date, and rating</li>
            <li>Assign directors to films</li>
            <li>Add and manage actors per film</li>
            <li>Edit and delete existing film records</li>
            <li>View detailed film information</li>
        </ul>
    </section>

    <section>
        <h2>Technologies used</h2>
        <ul>
            <li>ASP.NET Core MVC</li>
            <li>C# and Razor Views</li>
            <li>Entity Framework Core</li>
            <li>HTML5 and CSS</li>
        </ul>
    </section>

    <section>
        <h2>Get started</h2>
        <p>
            Use the navigation menu to browse films or add a new one to the collection.
        </p>
        <p>
            This application focuses on functionality and clarity rather than visual complexity.
        </p>
    </section>

    <footer>
        <p>
            Created by <strong>Romeo Weyns</strong>
        </p>
    </footer>
</main>