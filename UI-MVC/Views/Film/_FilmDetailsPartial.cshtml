@model FilmManagement.UI.Web.Models.Film.DetailsFilmViewModel

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Title)</dt>
            <dd class="col-sm-9">@Model.Title</dd>
            
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Genre)</dt>
            <dd class="col-sm-9">@Model.Genre</dd>
            
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.ReleaseDate)</dt>
            <dd class="col-sm-9">@Model.ReleaseDate.ToString("dd/MM/yyyy")</dd>
            
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Rating)</dt>
            <dd class="col-sm-9">@Model.Rating.ToString("F1") / 10</dd>
            
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Director)</dt>
            <dd class="col-sm-9">
                @if (Model.Director != null)
                {
                    <a asp-controller="Director" asp-action="Details" asp-route-id="@Model.Director.ImdbId">
                        @Model.Director.Name
                    </a>
                }
                else
                {
                    <span class="text-muted">Unknown</span>
                }
            </dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Actors)</dt>
            <dd class="col-sm-9">
                @if (Model.Actors != null && Model.Actors.Any())
                {
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Date of Birth</th>
                                <th>Screen Time</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var actor in Model.Actors)
                            {
                                <tr>
                                    <td>@actor.Name</td>
                                    <td>@actor.DateOfBirth.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <form asp-controller="Film" asp-action="UpdateScreenTime" method="post" class="d-inline">
                                            <input type="hidden" name="filmId" value="@Model.ImdbId" />
                                            <input type="hidden" name="actorId" value="@actor.ImdbId" />
                                            <div class="input-group input-group-sm" style="width: 150px;">
                                                <input type="number" 
                                                       name="screenTime" 
                                                       value="@actor.ScreenTime" 
                                                       class="form-control" 
                                                       placeholder="minutes"
                                                       min="0" />
                                                <button type="submit" class="btn btn-sm btn-primary">Update</button>
                                            </div>
                                        </form>
                                    </td>
                                    <td>
                                        <a asp-controller="Actor" asp-action="Details" asp-route-id="@actor.ImdbId">Details</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <span class="text-muted">No actors assigned</span>
                }
            </dd>
        </dl>
    </div>
</div>