@model IEnumerable<Director>

@{
    ViewBag.Title = "title";
}

<h2>All Directors</h2>

<p>
    <a asp-action="Refresh" class="btn btn-primary">Refresh Directors List</a>
</p>

<table class="table table-striped">
    <thead>
    <tr>
        <th>Name</th>
        <th>Country</th>
        <th>Career Start</th>
        <th>Career End</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var director in Model)
    {
        <tr>
            <td>@director.Name</td>
            <td>@director.Country</td>
            <td>@director.CareerStart</td>
            <td>@director.CareerEnd</td>
            <td>
                <a asp-action="Details" asp-route-id="@director.ImdbId">Details</a>
            </td>
        </tr>
    }
    </tbody>
</table>
