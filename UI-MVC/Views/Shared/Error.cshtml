@model ErrorViewModel
@{
    ViewData["Title"] = Model?.Title ?? "Error";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="text-center mb-4">
                @switch (Model?.StatusCode)
                {
                    case 404:
                        <h1 class="display-1 text-muted">404</h1>
                        break;
                    case 403:
                        <h1 class="display-1 text-warning">403</h1>
                        break;
                    case 400:
                        <h1 class="display-1 text-info">400</h1>
                        break;
                    default:
                        <h1 class="display-1 text-danger">@(Model?.StatusCode ?? 500)</h1>
                        break;
                }
                
                <h2 class="mb-3">@(Model?.Title ?? "Error")</h2>
                
                @if (!string.IsNullOrEmpty(Model?.Message))
                {
                    <p class="lead text-muted">@Model.Message</p>
                }
            </div>

            @if (Model?.ShowRequestId == true)
            {
                <div class="alert alert-secondary" role="alert">
                    <strong>Request ID:</strong> <code>@Model.RequestId</code>
                </div>
            }

            <div class="text-center mt-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-house"></i> Go to Home
                </a>
                <a href="javascript:history.back()" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Go Back
                </a>
            </div>
        </div>
    </div>
</div>