### Get all directors (JSON)
GET http://localhost:5199/api/directors
Accept: application/json

> {%
    if (response.body?.$values?.length > 0) {
        client.global.set("directorId", response.body.$values[0].imdbId);
    } else {
        throw "No directors returned";
    }
%}

### Get specific director
GET http://localhost:5199/api/directors/{{directorId}}
Accept: application/json

### Get films by director
GET http://localhost:5199/api/directors/{{directorId}}/films
Accept: application/json

### Create a new director
POST http://localhost:5199/api/directors
Accept: application/json
Content-Type: application/json

{
  "name": "Romeo Weyns",
  "country": "Belgium",
  "careerStart": 1995,
  "careerEnd": null
}

> {%
    client.global.set("newDirectorId", response.body.imdbId);
%}

### Get all films
GET http://localhost:5199/api/films
Accept: application/json

> {%
    if (response.body?.$values?.length > 0) {
        client.global.set("filmId", response.body.$values[0].imdbId);
    }
%}

### Get films by genre (Action = 1)
GET http://localhost:5199/api/films?genre=1
Accept: application/json

### Get specific film
GET http://localhost:5199/api/films/{{filmId}}
Accept: application/json

### Create film
POST http://localhost:5199/api/films
Accept: application/json
Content-Type: application/json

{
  "title": "Dogtooth",
  "genre": 38,
  "releaseDate": "2010-03-11",
  "rating": 7.9,
  "directorId": "{{directorId}}"
}

> {%
    client.global.set("newFilmId", response.body.imdbId);
%}

### Create film without director (should work)
POST http://localhost:5199/api/films
Accept: application/json
Content-Type: application/json

{
  "title": "1234",
  "genre": 4,
  "releaseDate": "2024-01-01",
  "rating": 7.0,
  "directorId": null
}

### Update film
PUT http://localhost:5199/api/films/{{newFilmId}}
Accept: application/json
Content-Type: application/json

{
  "title": "Dogtooth (Updated)",
  "genre": 38,
  "releaseDate": "2023-12-08",
  "rating": 8.0,
  "directorId": "{{directorId}}"
}

### Delete film
DELETE http://localhost:5199/api/films/{{newFilmId}}
Accept: application/json

### Get actors of a film
GET http://localhost:5199/api/films/{{filmId}}/actors
Accept: application/json

### Get all actors
GET http://localhost:5199/api/actors
Accept: application/json

> {%
    if (response.body?.$values?.length > 0) {
        client.global.set("actorId", response.body.$values[0].imdbId);
    }
%}

### Get specific actor
GET http://localhost:5199/api/actors/{{actorId}}
Accept: application/json

### Create actor
POST http://localhost:5199/api/actors
Accept: application/json
Content-Type: application/json

{
  "name": "Romeo Weyns",
  "nationality": "Belgian",
  "dateOfBirth": "1995-03-20",
  "dateOfDeath": null
}

> {%
    client.global.set("newActorId", response.body.imdbId);
%}

### Update actor
PUT http://localhost:5199/api/actors/{{newActorId}}
Accept: application/json
Content-Type: application/json

{
  "name": "Romeo Weyns (Updated)",
  "nationality": "American",
  "dateOfBirth": "1895-12-20",
  "dateOfDeath": null
}

### Delete actor
DELETE http://localhost:5199/api/actors/{{newActorId}}
Accept: application/json

### Get films by actor
GET http://localhost:5199/api/actors/{{actorId}}/films
Accept: application/json

### Create actor-film relationship
POST http://localhost:5199/api/actorfilms
Accept: application/json
Content-Type: application/json

{
  "filmId": "{{filmId}}",
  "actorId": "{{actorId}}",
  "screenTime": 105
}

### Get specific actor-film relationship
GET http://localhost:5199/api/actorfilms/{{filmId}}/{{actorId}}
Accept: application/json

### Update screen time
PUT http://localhost:5199/api/actorfilms/{{filmId}}/{{actorId}}
Accept: application/json
Content-Type: application/json

120

### Delete actor-film relationship
DELETE http://localhost:5199/api/actorfilms/{{filmId}}/{{actorId}}
Accept: application/json

### Get non-existent film
GET http://localhost:5199/api/films/00000000-0000-0000-0000-000000000000
Accept: application/json

### Create film with invalid data
POST http://localhost:5199/api/films
Accept: application/json
Content-Type: application/json

{
  "title": "Ab",
  "genre": 999999,
  "releaseDate": "2099-12-08",
  "rating": 15.0
}

### Create film with non-existent director
POST http://localhost:5199/api/films
Accept: application/json
Content-Type: application/json

{
  "title": "Test Film",
  "genre": 4,
  "releaseDate": "2023-01-01",
  "rating": 7.0,
  "directorId": "00000000-0000-0000-0000-000000000000"
}